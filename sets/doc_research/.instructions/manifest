# Ownership of every file this notebook ships. Read by doc_research/scripts/update.sh
# and by check.py. Paths are relative to the REPOSITORY root. See
# doc_research/UPDATING.md.
#
#   template  replaced outright on update. Never edit these.
#   merge     three-way merged against the version originally installed.
#   seed      written once at install, never touched again.
#
# Anything not listed here — doc_research/labbook/entries/, calculations/,
# figures/, log/weekly/, and all of the repository's own code — is invisible to
# the updater and cannot be modified by it.
#
# Patterns are shell globs in which `*` also matches `/`, so `doc_research/x/*`
# covers nested paths. The LAST matching line wins.

template  CLAUDE.md
template  .claude/commands/*
template  doc_research/CLAUDE.md
template  doc_research/AGENTS.md
template  doc_research/UPDATING.md
template  doc_research/labbook/preamble.tex
template  doc_research/labbook/00_rules.tex
template  doc_research/labbook/README.md
template  doc_research/log/README.md
template  doc_research/calculations/README.md
template  doc_research/calculations/_template/*
template  doc_research/figures/README.md
template  doc_research/figures/_template.md
template  doc_research/scripts/*
template  doc_research/.gitignore

merge     doc_research/pixi.toml
merge     .claude/settings.json

seed      doc_research/NOTEBOOK.md
seed      doc_research/TASTE.md
seed      doc_research/FEEDBACK.md
seed      doc_research/ONBOARDING.md
seed      doc_research/INDEX.md
seed      doc_research/labbook.tex
seed      doc_research/worklog.tex
seed      doc_research/labbook/entries.tex
seed      doc_research/log/weeks.tex
