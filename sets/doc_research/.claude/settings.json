{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/doc_research/friday.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/doc_research/check.py)",
      "Bash(python3 scripts/doc_research/check.py --write)",
      "Bash(python3 scripts/doc_research/build_entries.py)",
      "Bash(python3 scripts/doc_research/weekly.py*)",
      "Bash(pixi run check*)",
      "Bash(pixi run entries)",
      "Bash(pixi run week)",
      "Bash(pixi run labbook)",
      "Bash(pixi run worklog)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)"
    ]
  }
}
